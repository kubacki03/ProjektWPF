<Page x:Class="ProjektWPF.HomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asystent AI"  MinWidth="800" MinHeight="650">

    <Grid RenderTransformOrigin="0.588,0.632">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"  />
            <ColumnDefinition Width="0" x:Name="SidePanelColumn"/>
            <ColumnDefinition Width="0" x:Name="SidePanel2Column"/>
            <ColumnDefinition Width="0" x:Name="SidePanel3Column"/>
        </Grid.ColumnDefinitions>
        
        
        <TextBlock Text="{Binding MonthExpensesText}" FontSize="36"  HorizontalAlignment="Center" Foreground="Wheat"/>
         
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right"  Margin="0,0,0,20">
            <Button Content="🤖" FontSize="20" Width="40" Height="40" Click="ToggleSidePanel" Margin="20"/>
            <Button Content="CPU" FontSize="20" Width="40" Height="40" Click="ToggleSidePanel3" Margin="20"/>
            <Button Content="🎵" FontSize="20" Width="40" Height="40" Click="ToggleSidePanel2" Margin="20"/>
            
        </StackPanel>
 
        <Border Grid.Column="1" Background="LightGray" Width="250">
            <StackPanel Margin="10">
                <ListBox ItemsSource="{Binding Messages}" Height="200">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Author}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Content}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="{Binding RecordButtonText}" Height="40" Command="{Binding ToggleRecordingCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="3" Background="LightGray" Width="250">
            <StackPanel Margin="10">
                <TextBlock Text="{Binding RamText}"/>
                <TextBlock Text="{Binding CpuText}"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="LightGray" Width="250">
            <StackPanel Margin="10">
                <Button Content="Login" Command="{Binding SpotifyLoginCommand}"/>
                <Button Content="Pause" Command="{Binding PauseCommand}"/>
                <Button Content="Play Random Album" Command="{Binding StartPlayCommand}"/>
                <Button Content="Start play" Command="{Binding StartPlayCommand}"/>
                <Slider Minimum="0" Maximum="1" Value="{Binding VolumeLevel}"
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    Orientation="Horizontal" Width="200"/>
                <Button Content="Skip next" Command="{Binding SkipNextCommand}"/>
                <Button Content="Skip previous" Command="{Binding SkipPreviousCommand}"/>
            </StackPanel>
        </Border>
 
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left"  Margin="20,0,0,0">
            <Button Content="Notatnik" FontSize="20" Width="120" Height="40" Command="{Binding NavigateToNotesCommand}" Margin="20"/>
            <Button Content="Filmy" FontSize="20" Width="120" Height="40" Command="{Binding NavigateToMoviesCommand}" Margin="20"/>
            <Button Content="Wydatki" FontSize="20" Width="120" Height="40" Command="{Binding NavigateToExpensesCommand}" Margin="20"/>
            <TextBlock Text="{Binding WeatherText}" FontSize="20" Width="170" Height="60" Margin="20" Foreground="WhiteSmoke"/>
            
            <StackPanel    Width="186" Height="218">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox Width="40" Text="{Binding MinutesInput, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text=":" FontSize="20" VerticalAlignment="Center" Margin="5,0,5,0"/>
                <TextBox Width="40" Text="{Binding SecondsInput, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <Button Content="Ustaw czas" Command="{Binding SetTimeCommand}" Width="100" Margin="10"/>
            <TextBlock Text="{Binding TimeDisplay}" FontSize="36" HorizontalAlignment="Center" Margin="10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="Start" Command="{Binding StartTimerCommand}" Width="75"/>
                <Button Content="Stop" Command="{Binding StopTimerCommand}" Width="75" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
            <Button Content="LogOut" FontSize="20" Width="90" Height="40" Command="{Binding LogoutCommand}" Margin="20"/>
        </StackPanel>

    </Grid>

</Page>
