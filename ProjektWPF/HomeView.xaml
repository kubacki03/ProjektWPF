<Page x:Class="ProjektWPF.HomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asystent AI"  MinWidth="800" MinHeight="650">

    <Grid RenderTransformOrigin="0.588,0.632">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"  />
            <ColumnDefinition Width="0" x:Name="SidePanelColumn"/>
            <ColumnDefinition Width="0" x:Name="SidePanel2Column"/>
            <ColumnDefinition Width="0" x:Name="SidePanel3Column"/>
        </Grid.ColumnDefinitions>
        
        
        <TextBlock x:Name="MonthExpenses" FontSize="36"  HorizontalAlignment="Center" Foreground="Wheat"/>
        
        
        <!-- Panel dla przycisków -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right"  Margin="0,0,0,20">
            <Button Content="🤖" FontSize="20" Width="40" Height="40" Click="ToggleSidePanel" Margin="20"/>
            <Button Content="CPU" FontSize="20" Width="40" Height="40" Click="ToggleSidePanel3" Margin="20"/>
            <Button Content="🎵" FontSize="20" Width="40" Height="40" Click="ToggleSidePanel2" Margin="20"/>
            
        </StackPanel>

        <!-- Wysuwane panele boczne -->
        <Border Grid.Column="1" Background="LightGray" Width="250">
            <StackPanel Margin="10">
                <ListBox ItemsSource="{Binding Messages}" Height="200">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Author}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Content}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="RecordButton" Content="Start Recording" Height="40" Click="ToggleRecording"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="3" Background="LightGray" Width="250">
            <StackPanel Margin="10">
                <TextBlock x:Name="RamUsage"/>
                <TextBlock x:Name="CpuUsage"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="LightGray" Width="250">
            <StackPanel Margin="10">
                <Button x:Name="Login" Content="Login" Click="SpotifyLoginButton_Click"/>
                <Button x:Name="Pause" Content="Pause" Click="PauseButton_Click"/>
                <Button x:Name="Play" Content="Play Random Album" Click="PlayButton_Click"/>
                <Button x:Name="StartSong" Content="Start play" Click="StartPlayButton_Click"/>
                <Slider x:Name="volumeSlider" Minimum="0" Maximum="1" Value="0.5"
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    Orientation="Horizontal" Width="200"
                    ValueChanged="VolumeSlider_ValueChanged"/>
                <Button x:Name="SkipToNext" Content="Skip next" Click="SkipNextButton_Click"/>
                <Button x:Name="SkipToPrevious" Content="Skip previous" Click="SkipPreviousButton_Click"/>
            </StackPanel>
        </Border>

       <!--Przyciski z lewej strony-->

        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left"  Margin="20,0,0,0">
            <Button Content="Notatnik" FontSize="20" Width="120" Height="40" Click="NavigateToNote" Margin="20"/>
            <Button Content="Filmy" FontSize="20" Width="120" Height="40" Click="NavigateToMovies" Margin="20"/>
            <Button Content="Wydatki" FontSize="20" Width="120" Height="40" Click="NavigateToExpenses" Margin="20"/>
            <TextBlock x:Name="Weather" FontSize="20" Width="170" Height="60" Margin="20" Foreground="WhiteSmoke"/>
            
            <StackPanel    Width="186" Height="218">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="MinutesInput" Width="40" Text="1"/>
                <TextBlock Text=":" FontSize="20" VerticalAlignment="Center" Margin="5,0,5,0"/>
                <TextBox x:Name="SecondsInput" Width="40" Text="00"/>
            </StackPanel>

            <Button Content="Ustaw czas" Click="SetTime_Click" Width="100" Margin="10"/>
            <TextBlock x:Name="TimeDisplay" FontSize="36" Text="01:00" HorizontalAlignment="Center" Margin="10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="Start" Click="StartTimer_Click" Width="75"/>
                <Button Content="Stop" Click="StopTimer_Click" Width="75" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
            <Button Content="LogOut" FontSize="20" Width="90" Height="40" Click="Logout" Margin="20"/>
        </StackPanel>

    </Grid>

</Page>
