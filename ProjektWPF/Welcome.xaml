<Page x:Class="ProjektWPF.Welcome"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjektWPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Welcome">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="UsersPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Orientation="Horizontal">
                <!-- Tutaj dynamicznie zostaną dodani użytkownicy -->
            </StackPanel>
        </ScrollViewer>
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Content="Login" Click="Login" Margin="5" Width="200" Height="50"/>
            <Button Content="Zarejestruj" Click="ShowRegister" Margin="5" Width="200" Height="50"/>

        </StackPanel>
    </Grid>
</Page>
