<Page x:Class="ProjektWPF.Welcome"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjektWPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Welcome">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SavedUsers}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.LoginSavedUserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Id}"
                                Background="Transparent" BorderThickness="0" Margin="10">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Grid Width="100" Height="100">
                                    <Ellipse Width="100" Height="100" Fill="LightGray" Stroke="Black" StrokeThickness="2"/>
                                    <TextBlock Text="🧑" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Content="Login" Command="{Binding ShowLoginCommand}" Margin="5" Width="200" Height="50"/>
            <Button Content="Zarejestruj" Command="{Binding ShowRegisterCommand}" Margin="5" Width="200" Height="50"/>

        </StackPanel>
    </Grid>
</Page>
